											<property name="additionalText">
												<string><![CDATA[#!/usr/bin/env xdg-open
[Desktop Entry]
    Version=1.0
    Comment=No Magic Inc.
    Name=MagicDraw Demo 2021x Refresh1
    Exec="$USER_INSTALL_DIR$$/$bin/magicdraw"
    Icon=$USER_INSTALL_DIR$$/$bin/magicdraw.ico
    Type=Application
    Categories=Development;GTK;GNOME;Utility;
    Terminal=false

[Desktop Action SubmitIssue]
    Exec="$USER_INSTALL_DIR$$/$bin/submit_issue"
    Name=Submit Issue

[Desktop Action Manual]
    Exec=xdg-open "$USER_INSTALL_DIR$$/$manual/MagicDraw UserManual.pdf"
    Name=User Manual

[Desktop Action OpenFolder]
    Exec=xdg-open "$USER_INSTALL_DIR$$/$"
    Name=Go To Installation]]></string>
