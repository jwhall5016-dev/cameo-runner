<?xml version="1.0" encoding="UTF-8"?>
<template>
   <name>Tutorial 28 - Import Tool</name>
   <description>This sample template will dynamically import contents form another File. The Import Tool supports RTF, HTML, XML, DOCX, and text files only.</description>
   <templateFile>template.docx</templateFile>
   <icon />
   <enable>true</enable>
   <readonly>true</readonly>
   <category>Tutorial</category>
   <variables>
      <variable>
         <name>Author</name>
         <value xml:space="preserve">Roger Holenweger</value>
      </variable>
      <variable>
         <name>Publisher</name>
         <value xml:space="preserve">No Magic</value>
      </variable>
   </variables>
   <perspectives />
</template>
