<?xml version="1.0" encoding="UTF-8"?>
<report>
   <name>Built-in</name>
   <description>A built-in template</description>
   <defaultReport>true</defaultReport>
   <variables>
   		<variable>
			<name>CompanyName</name>
			<description>A company's name</description>
			<type/>			
			<value xml:space="preserve">No Magic</value>
		</variable>
		<variable>
			<name>CompanyAddress</name>
			<description>A company's address</description>
			<type/>			
			<value xml:space="preserve">One Allen Center, 700 Central Expressway South, Suite 110 Allen, Texas 75013 USA</value>
		</variable>	
      <variable>
         <name>Author</name>
         <description />
         <type />
         <value xml:space="preserve">No Magic</value>
      </variable>
      <variable>
         <name>Publisher</name>
         <description />
         <type />
         <value xml:space="preserve">No Magic</value>
      </variable>
   </variables>
   <selectedPackage>
      <packageId />
      <selectRecursive>true</selectRecursive>
      <showAuxiliary>false</showAuxiliary>
      <showOnlyPackageElement>true</showOnlyPackageElement>
   </selectedPackage>
   <outputProperty>
      <outputFile />
      <outputImageFormat>png</outputImageFormat>
      <outputFitImageSize>1</outputFitImageSize>
      <outputOnBlankField />
      <displayInViewer>true</displayInViewer>
      <outputFormat />
      <uploadProfile />
   </outputProperty>
</report>