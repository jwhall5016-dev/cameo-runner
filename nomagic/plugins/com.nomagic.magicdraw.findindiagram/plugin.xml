<?xml version="1.0" encoding="UTF-8"?>
<plugin
        id="FindInDiagram"
        name="Find in Diagram"
        version="2021x Refresh1"
        provider-name="No Magic"
        class="com.nomagic.magicdraw.search.FindInDiagramPlugin">

    <requires>
        <api version="1.0"/>
        <required-plugin id="DependencyMatrixPlugin" name="Dependency Matrix"/>
        <required-plugin id="com.nomagic.magicdraw.visualization.relationshipmap" name="Relation Map"/>
        <required-plugin id="com.nomagic.magicdraw.diagramtable" name="Diagram Table"/>
    </requires>

    <runtime>
        <library name="findindiagram.jar"/>
        <library name="findindiagram_api.jar"/>
    </runtime>
</plugin>