package io.cameorestservice.cameo;

import java.nio.file.Files;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;
import java.nio.file.Path;


@RestController()
public class CameoController {
	
	private Path tempMbseFilePath;
	private Path tempJsonOutputFilePath;
	@Autowired
	private CameoManager cameoManager;
	
	public CameoController()throws Exception {
		tempMbseFilePath = Files.createTempFile(null, ".mdzip");
		tempJsonOutputFilePath = Files.createTempFile(null, ".json");
	}
	
	@RequestMapping("/test")
	public String Test() {
		return "hi there";
	}
	
	@RequestMapping("/cameoOutput")
	public String CameoOutput() throws Exception {
		String json = new String(Files.readAllBytes(tempJsonOutputFilePath));
		return json;
	}
	
	@RequestMapping("/runCameo/{packageName}")
	public String RunCameo(@PathVariable String packageName) throws Exception{
		//String packageName = "testPackage";
		//String tempMDZIPPath = "C:/test.MDZIP";
		
		try 
	    {
			cameoManager.startSecondJVM(tempMbseFilePath.toString(), tempJsonOutputFilePath.toString(), packageName);
	    }
	    catch(Exception ex) {
			String secondVMError = ex.getMessage();
			System.out.println("Couldn't start second VM: " + secondVMError);
	    }
		return "starting cameo application";
	}
	
	@RequestMapping(method=RequestMethod.POST, value= "/UploadMDZIP")
	public String UploadMDZIP(@RequestBody byte[] mbseFile) throws Exception{

		Files.write(tempMbseFilePath, mbseFile);
		return "file uploaded";
	}
	


}
